+        .4*base.expected_counts(lambda e:1,[0,.5,1],2,(0,1)),rtol=1e-13)
+    with pytest.raises(ValueError):CallableEfficiency(lambda e:1.01)(1)
+    assert CallableEfficiency(lambda e:.2 if e<1 else .4)([0,1]).tolist()==[.2,.4]
