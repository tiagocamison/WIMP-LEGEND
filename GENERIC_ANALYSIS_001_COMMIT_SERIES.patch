+
+@pytest.mark.parametrize('model',[NoSmearing(),GaussianResolution(0),GaussianResolution(lambda mean:0)])
+def test_delta_edge_assignment(model):
+    np.testing.assert_array_equal(model.bin_probabilities([0,1,2,3],[0,1,2]),
+                                  [[1,0],[0,1],[0,1],[0,0]])
